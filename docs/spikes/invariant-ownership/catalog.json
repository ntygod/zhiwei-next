{
  "schemaVersion": 1,
  "invariants": [
    {
      "id": "I-EVENT-SHAPE",
      "owners": [
        "protocol"
      ],
      "maturity": "formal-v1",
      "summary": "闭合形状、版本、canonical body/身份",
      "entries": [
        {
          "export": "createNormalizedRuntimeEventV1"
        },
        {
          "export": "parseNormalizedRuntimeEventV1"
        }
      ],
      "tests": [
        {
          "file": "packages/protocol/src/runtime-event-v1.test.ts",
          "name": "v1 canonical body, source-slot event ID and idempotency key have fixed golden vectors",
          "role": "positive"
        },
        {
          "file": "packages/protocol/src/runtime-event-v1.test.ts",
          "name": "parser fails closed for protocol, identity, phase and global-order drift",
          "role": "negative"
        }
      ],
      "limitations": "Adapter 调用 create、Ledger 调用 parse，复用 protocol 断言；只验证单事件，不证明目标存在。"
    },
    {
      "id": "I-TRACE-RELATIONS",
      "owners": [
        "protocol"
      ],
      "maturity": "formal-v1",
      "summary": "同域严格顺序、先行关联、完整回放",
      "entries": [
        {
          "export": "parseNormalizedRuntimeEventTraceV1"
        },
        {
          "export": "assertReplayableNormalizedRuntimeEventTraceV1"
        }
      ],
      "tests": [
        {
          "file": "packages/protocol/src/runtime-event-stream-v1.test.ts",
          "name": "independent sequence domains may both start at one without implying a total order",
          "role": "positive"
        },
        {
          "file": "packages/protocol/src/runtime-event-stream-v1.test.ts",
          "name": "Tool links cannot borrow a declaration from another Agent Run or Runtime instance",
          "role": "negative"
        },
        {
          "file": "packages/protocol/src/runtime-event-stream-v1.test.ts",
          "name": "explicit links cannot point forward",
          "role": "negative"
        },
        {
          "file": "packages/protocol/src/runtime-event-stream-v1.test.ts",
          "name": "complete replay fails closed on required unknown vocabulary",
          "role": "negative"
        }
      ],
      "limitations": "调用方须提供足够 Trace，不等于单批 append。"
    },
    {
      "id": "I-PI-PROJECTION",
      "owners": [
        "pi-adapter"
      ],
      "maturity": "formal-v1",
      "summary": "字段级投影，不发明关联",
