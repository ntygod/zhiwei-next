        },
        {
          "file": "packages/memory-store/src/sqlite-observation-ledger.test.ts",
          "name": "source-slot conflict is rejected before it can become a duplicate row",
          "role": "negative"
        },
        {
          "file": "packages/memory-store/src/sqlite-observation-ledger.test.ts",
          "name": "sequence monotonicity is scoped to the complete v1 source stream",
          "role": "negative"
        }
