{
  "name": "zhiwei-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "npm run check:architecture && npm run check:agents && npm run check:work-items && npm run check:main-provenance && npm run check:main-provenance-dispatch && npm run check:branch-cleanup && npm run check:harness && npm run check:pi-spike && npm run check:pi-artifact && npm run check:pi-lifecycle && npm run check:pi-retry-lifecycle && npm run check:pi-follow-up-lifecycle && npm run check:pi-cancel-retry-exhaustion && npm run check:pi-parallel-tool-ordering && npm run check:pi-compaction-session-replacement && npm run check:pi-sdk-rpc-parity && npm run test",
    "test": "node scripts/test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:agents": "node scripts/check-agents.mjs",
    "check:work-items": "node scripts/check-work-item-governance.mjs",
    "check:main-provenance": "node scripts/check-main-provenance.mjs",
    "check:main-provenance-dispatch": "node scripts/check-main-provenance-dispatch.mjs",
    "check:branch-cleanup": "node scripts/check-branch-cleanup.mjs",
    "check:harness": "node scripts/check-harness.mjs",
    "check:pi-spike": "node scripts/check-pi-spike.mjs",
    "check:pi-artifact": "node scripts/check-pi-artifact-result.mjs",
    "check:pi-lifecycle": "node scripts/check-pi-lifecycle-result.mjs",
    "check:pi-retry-lifecycle": "node scripts/check-pi-retry-lifecycle-result.mjs",
    "check:pi-follow-up-lifecycle": "node scripts/check-pi-follow-up-lifecycle-result.mjs",
    "check:pi-cancel-retry-exhaustion": "node scripts/check-pi-cancel-retry-exhaustion-result.mjs",
    "check:pi-parallel-tool-ordering": "node scripts/check-pi-parallel-tool-ordering-result.mjs",
    "check:pi-compaction-session-replacement": "node scripts/check-pi-compaction-session-replacement-result.mjs",
    "check:pi-sdk-rpc-parity": "node scripts/pi-sdk-rpc-parity-fixture.mjs --check",
    "check:pr": "node scripts/check-pr-contract.mjs",
    "probe:pi:sdk": "node scripts/probes/pi-sdk-surface.mjs",
    "probe:pi:rpc": "node scripts/probes/pi-rpc-state.mjs",
    "probe:pi:artifact": "node scripts/probes/pi-artifact-ci.mjs",
    "probe:pi:lifecycle": "node scripts/probes/pi-lifecycle-ci.mjs",
    "probe:pi:retry-lifecycle": "PI_LIFECYCLE_SCENARIO=retry-success PI_LIFECYCLE_CAPTURE_SCRIPT=scripts/probes/pi-retry-lifecycle-capture.mjs node scripts/probes/pi-lifecycle-ci.mjs",
    "probe:pi:follow-up-lifecycle": "PI_LIFECYCLE_SCENARIO=follow-up-queue PI_LIFECYCLE_CAPTURE_SCRIPT=scripts/probes/pi-follow-up-lifecycle-capture.mjs node scripts/probes/pi-lifecycle-ci.mjs",
    "probe:pi:cancel-retry-exhaustion": "PI_LIFECYCLE_SCENARIO=cancel-retry-exhaustion PI_LIFECYCLE_CAPTURE_SCRIPT=scripts/probes/pi-cancel-retry-exhaustion-capture.mjs node scripts/probes/pi-lifecycle-ci.mjs",
    "probe:pi:parallel-tool-ordering": "PI_LIFECYCLE_SCENARIO=parallel-tool-ordering PI_LIFECYCLE_CAPTURE_SCRIPT=scripts/probes/pi-parallel-tool-ordering-capture.mjs node scripts/probes/pi-lifecycle-ci.mjs",
    "probe:pi:compaction-session-replacement": "PI_LIFECYCLE_SCENARIO=compaction-session-replacement PI_LIFECYCLE_CAPTURE_SCRIPT=scripts/probes/pi-compaction-session-replacement-capture.mjs node scripts/probes/pi-lifecycle-ci.mjs",
    "probe:pi:sdk-rpc-parity": "PI_LIFECYCLE_SCENARIO=sdk-rpc-parity PI_LIFECYCLE_CAPTURE_SCRIPT=scripts/probes/pi-sdk-rpc-parity-composite-capture.mjs node scripts/probes/pi-lifecycle-ci.mjs",
    "start:daemon": "node --experimental-strip-types apps/daemon/src/index.ts",
    "start:cli": "node --experimental-strip-types apps/cli/src/index.ts"
  }
}
